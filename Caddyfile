{$SITE_ADDRESS} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
 }
 handle /api/* {
  reverse_proxy app:8000
 }
 handle /assets-bank/* {
  reverse_proxy app:8000
 }
 @simple path /simple /simple/*
 handle @simple {
  root * /srv
  try_files {path} /simple/index.html
  file_server
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
